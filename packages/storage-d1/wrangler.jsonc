{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storage-d1-test",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitig-d1-test",
      "database_id": "test-db",
      "migrations_dir": "./migrations"
    }
  ]
}

